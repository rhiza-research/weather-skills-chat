  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "config": {
          "host-sending-registration-request-must-match": ["false"],
          "client-uris-must-match": ["true"],
          "trusted-hosts": ["localhost", "claude.ai"]
        }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "anonymous",
        "config": {
          "allow-default-scopes": ["true"]
        }
      }
    ]
  },
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization"
  ],
  "attributes": {
    "localStackNote": "This realm ships one sign-in user, its email address and its password, all substituted from the environment at import. That is acceptable for two reasons. Nothing here is a literal secret: every one of those values is an environment placeholder, as is the client secret. And none of it reaches the shipped image: this file is copied in only by keycloak/Dockerfile, which builds the provider image that docker-compose.keycloak.yaml selects and CI does not build, and although the application image's build context does include this directory, its final stage copies only the frontend build, CHANGELOG.md, package.json and the backend. No chart or manifest references it. It exists so that rebuilding the provider does not cost a hand-made account. Do not use it anywhere but the local compose stack."
  },
  "users": [
    {
      "id": "be464b88-b097-4f3a-8ed6-8cdbae6892f3",
      "username": "${KEYCLOAK_USER_USERNAME}",
      "email": "${KEYCLOAK_USER_EMAIL}",
      "firstName": "${KEYCLOAK_USER_FIRST_NAME}",
      "lastName": "${KEYCLOAK_USER_LAST_NAME}",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["default-roles-weather-skills-chat"],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": []
    }
  ]
}
