# Variables for the local stack. Optional: copy to .env to override these defaults, and replace
# every REPLACE_ME. Start the stack with:
#
#   ./run-compose.sh --redis --build
#
# No compose project name is set, so the project name and its volume names come from the checkout
# directory name.
#
# The application always serves the MCP endpoint. The endpoint is its own OAuth authorization
# server: MCP clients register, and the user signs in with a web interface account and approves
# the client. When WEBUI_URL is not set, the application uses http://localhost:3000. When it is
# neither an https address nor a loopback address, the application does not start.
#
# MCP clients send OAuth credentials over plain http only to localhost. With a remote Docker
# daemon, forward the port from the machine the browser and the client run on:
#
#   ssh -L 3000:localhost:3000 <user>@<docker-host>
#
# using OPEN_WEBUI_PORT for the port number.

# The address clients use to reach this service, with no trailing slash: http://localhost and
# OPEN_WEBUI_PORT. The MCP endpoint's resource identifier is this address with /mcp appended, and
# its authorization server's issuer is this address. The endpoint reads it at startup, so a value
# changed later in the admin settings takes effect only after a restart.
WEBUI_URL=http://localhost:3000

# Comma-separated redirect URIs an MCP client may register or use besides loopback http addresses
# (localhost, 127.0.0.1, ::1, any port). Each entry is an exact URL or a prefix ending in *, with
# any scheme, for example a remote test host. Empty allows only loopback http. A prefix matches
# any path that starts with it, including sibling paths: https://host/cb* also matches
# https://host/cb-other.
#MCP_OAUTH_ALLOWED_REDIRECT_URIS=

# Use an OpenAI-compatible provider instead of the ollama service in docker-compose.yaml. With
# ENABLE_OLLAMA_API=false the application does not poll ollama.
ENABLE_OLLAMA_API=false
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=REPLACE_ME

# Signs web interface sessions. Any long random string. The MCP endpoint's consent page reads the
# session it signs; the endpoint's own tokens are random values stored as hashes.
WEBUI_SECRET_KEY=REPLACE_ME

# Must match the port in WEBUI_URL.
OPEN_WEBUI_PORT=3000

# Container name, image name, and tag for the application. These replace the upstream defaults so
# a local build does not retag an image used by another stack on the same Docker daemon.
WEBUI_CONTAINER_NAME=weather-skills-chat
WEBUI_IMAGE=weather-skills-chat
WEBUI_DOCKER_TAG=local

# Redis address. The one-time artifact link claims its nonce here, and the web interface stores its
# persistent configuration here.
#
# Leave it commented out. docker-compose.redis.yaml (./run-compose.sh --redis) sets it to the redis
# service it adds; without that overlay it is empty. Uncomment it only to point at a Redis you run
# elsewhere. If the URL names a host that does not exist, every configuration read fails.
#
# Setting it to an empty value disables the one-time link even with the overlay loaded, because
# the overlay uses ${REDIS_URL-...}, which passes an empty value through.
#REDIS_URL=redis://redis:6379/0

# SKILL_SANDLOCK enables Landlock confinement for skill subprocesses. docker-compose.yaml defaults
# it to false. Set it to true where the kernel supports Landlock.
#SKILL_SANDLOCK=true
