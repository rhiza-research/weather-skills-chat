# Local Docker secrets and machine settings. Copy to .env (gitignored).
# Isolation and HTTP/2 are flags on ./run-compose.sh, not this file.
# See wiki/Development.md.

# Signs web interface sessions. Any long random string. Keep it stable.
WEBUI_SECRET_KEY=REPLACE_ME

# Public address of this stack (links in email and what the model sends users).
# Leave unset unless you need a specific URL. --testing sets
# https://localhost:3443 when this is empty.
#WEBUI_URL=https://localhost:3443

OPEN_WEBUI_PORT=3000
CADDY_HTTPS_PORT=3443

# Container name, image name, tag, and data volume. These replace the upstream
# defaults so a local build does not retag another stack or drop existing data.
WEBUI_CONTAINER_NAME=weather-skills-chat
WEBUI_IMAGE=weather-skills-chat
WEBUI_DOCKER_TAG=local
WEBUI_DATA_VOLUME=weather-skills-chat-data

# An OpenAI-compatible provider. ./run-compose.sh --ollama adds an ollama service
# instead. Leave these unset to keep the provider already saved in the app.
#OPENAI_API_BASE_URLS=https://openrouter.ai/api/v1
#OPENAI_API_KEYS=REPLACE_ME

# Built-in send_email. Leave unset if unused.
#EMAIL_TOOL_SMTP_HOST=
#EMAIL_TOOL_SMTP_PORT=465
#EMAIL_TOOL_SMTP_USERNAME=
#EMAIL_TOOL_SMTP_PASSWORD=REPLACE_ME
#EMAIL_TOOL_SMTP_USE_TLS=true
#EMAIL_TOOL_FROM_EMAIL=
