# Local Docker secrets and machine settings. Copy to .env (gitignored).
# Isolation and HTTP/2 are flags on ./run-compose.sh, not this file.
# See wiki/Development.md.

# Signs web interface sessions. Any long random string. Keep it stable. The MCP
# endpoint's consent page reads the session it signs; the endpoint's own tokens
# are random values stored as hashes.
WEBUI_SECRET_KEY=REPLACE_ME

# Public address of this stack (links in email and what the model sends users),
# with no trailing slash. The MCP endpoint's resource identifier is this address
# with /mcp appended, and its authorization server's issuer is this address. It
# must be an https address or a loopback address, or the application does not
# start. The endpoint reads it at startup, so a value changed later in the admin
# settings takes effect only after a restart.
# Leave unset unless you need a specific URL. --testing sets
# https://localhost:3443 when this is empty; otherwise the application uses
# http://localhost:3000.
#
# MCP clients send OAuth credentials over plain http only to localhost. With a
# remote Docker daemon, forward the port from the machine the browser and the
# client run on, using OPEN_WEBUI_PORT (or CADDY_HTTPS_PORT with --testing):
#
#   ssh -L 3000:localhost:3000 <user>@<docker-host>
#WEBUI_URL=https://localhost:3443

# Comma-separated redirect URIs an MCP client may register or use besides
# loopback http addresses (localhost, 127.0.0.1, ::1, any port). Each entry is an
# exact URL or a prefix ending in *, with any scheme, for example a remote test
# host. Empty allows only loopback http. A prefix matches any path that starts
# with it, including sibling paths: https://host/cb* also matches
# https://host/cb-other.
#MCP_OAUTH_ALLOWED_REDIRECT_URIS=

OPEN_WEBUI_PORT=3000
CADDY_HTTPS_PORT=3443

# Container name, image name, tag, and data volume. These replace the upstream
# defaults so a local build does not retag another stack or drop existing data.
WEBUI_CONTAINER_NAME=weather-skills-chat
WEBUI_IMAGE=weather-skills-chat
WEBUI_DOCKER_TAG=local
WEBUI_DATA_VOLUME=weather-skills-chat-data

# An OpenAI-compatible provider. ./run-compose.sh --ollama adds an ollama service
# instead. Leave these unset to keep the provider already saved in the app.
#OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_API_KEY=REPLACE_ME

# Built-in send_email. Leave unset if unused.
#EMAIL_TOOL_SMTP_HOST=
#EMAIL_TOOL_SMTP_PORT=465
#EMAIL_TOOL_SMTP_USERNAME=
#EMAIL_TOOL_SMTP_PASSWORD=REPLACE_ME
#EMAIL_TOOL_SMTP_USE_TLS=true
#EMAIL_TOOL_FROM_EMAIL=

# Redis address. The one-time artifact link claims its nonce here, and the web interface stores its
# persistent configuration here.
#
# Leave it commented out. docker-compose.redis.yaml (./run-compose.sh --redis) sets it to the redis
# service it adds, in place of any value here; without that overlay it is unset. Uncomment it only
# to point at a Redis you run elsewhere, without the overlay. If the URL names a host that does not
# exist, every configuration read fails.
#REDIS_URL=redis://redis:6379/0
