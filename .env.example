# Variables for the local stack. Optional: copy to .env to override these defaults, and replace
# every REPLACE_ME. Start the stack with:
#
#   ./run-compose.sh --redis --build
#
# No compose project name is set, so the project name and its volume names come from the checkout
# directory name.
#
# The application always serves the MCP endpoint. When WEBUI_URL is not set, the application uses
# http://localhost:3000.

# An OpenAI-compatible provider. ./run-compose.sh --ollama adds an ollama service instead. With
# neither, the application starts with no provider, and one is added in the admin settings.
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=REPLACE_ME

# The address clients use to reach this service, with no trailing slash. The MCP endpoint uses it as
# its resource identifier.
WEBUI_URL=http://localhost:3000

# Signs web interface sessions. Any long random string. The MCP endpoint does not use it.
WEBUI_SECRET_KEY=REPLACE_ME

OPEN_WEBUI_PORT=3000

# Container name, image name, and tag for the application. These replace the upstream defaults so
# a local build does not retag an image used by another stack on the same Docker daemon.
WEBUI_CONTAINER_NAME=weather-skills-chat
WEBUI_IMAGE=weather-skills-chat
WEBUI_DOCKER_TAG=local

# SKILL_SANDLOCK enables Landlock confinement for skill subprocesses. Unset, the application
# default, true, applies. Set it to false where the kernel lacks Landlock: with it true there, the
# runner refuses every chat-sandboxed skill run. With it false, a skill subprocess can read and
# write any path the application user can reach in the container, including other accounts'
# artifacts.
#SKILL_SANDLOCK=false

# Redis address. The one-time artifact link claims its nonce here, and the web interface stores its
# persistent configuration here.
#
# Leave it commented out. docker-compose.redis.yaml (./run-compose.sh --redis) sets it to the redis
# service it adds, in place of any value here; without that overlay it is unset. Uncomment it only
# to point at a Redis you run elsewhere, without the overlay. If the URL names a host that does not
# exist, every configuration read fails.
#REDIS_URL=redis://redis:6379/0
