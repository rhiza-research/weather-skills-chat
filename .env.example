# Variables for the local stack. Optional: copy to .env to override these defaults, and replace
# every REPLACE_ME; the Keycloak overlay (--enable-keycloak) reads the KEYCLOAK_* admin and user
# values and OAUTH_CLIENT_SECRET from .env. Start the stack with:
#
#   ./run-compose.sh --enable-keycloak --redis --build
#
# No compose project name is set, so the project name and its volume names come from the checkout
# directory name.
#
# The application always serves the MCP endpoint. docker-compose.keycloak.yaml sets
# OPENID_PROVIDER_URL. When OPENID_PROVIDER_URL is empty, the application refuses to start. When
# WEBUI_URL is not set, the application uses http://localhost:3000.
#
# Browsers and MCP clients reach the application and keycloak at localhost, because MCP clients
# send OAuth credentials over plain http only to localhost. With a remote Docker daemon, forward
# both ports from the machine the browser and the client run on:
#
#   ssh -L 3000:localhost:3000 -L 8081:localhost:8081 <user>@<docker-host>
#
# using OPEN_WEBUI_PORT and KEYCLOAK_PORT for the two port numbers.

# The address clients use to reach this service, with no trailing slash: http://localhost and
# OPEN_WEBUI_PORT. The MCP endpoint uses it as its resource identifier and as the audience a token
# must name.
WEBUI_URL=http://localhost:3000

# Use an OpenAI-compatible provider instead of the ollama service in docker-compose.yaml. With
# ENABLE_OLLAMA_API=false the application does not poll ollama.
ENABLE_OLLAMA_API=false
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=REPLACE_ME

# Signs web interface sessions. Any long random string. The MCP endpoint does not use it.
WEBUI_SECRET_KEY=REPLACE_ME

# Matches the client in keycloak/realm-weather-skills-chat.json.
OAUTH_CLIENT_ID=weather-skills-chat
OAUTH_CLIENT_SECRET=REPLACE_ME
OAUTH_PROVIDER_NAME=Keycloak

# Keycloak's initial admin account, for the admin console at http://localhost and KEYCLOAK_PORT.
# KEYCLOAK_PORT is also part of the token issuer, http://localhost:<KEYCLOAK_PORT>/realms/...
KEYCLOAK_ADMIN_USERNAME=REPLACE_ME
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME
KEYCLOAK_PORT=8081

# The user who signs in to the web interface. The realm import creates this user from these five
# values. The user's id is fixed in the realm file, so the application's account stays linked after
# keycloak is recreated. See the note in keycloak/realm-weather-skills-chat.json before using this
# outside the local stack.
#
# All five are required, and nothing validates them. A missing value is substituted as an empty
# string and the import still succeeds. A missing username, email, or password makes sign-in fail
# with Keycloak's generic invalid-credentials error. A missing first or last name sends the first
# sign-in to Keycloak's update-account page, because the realm's user profile requires both.
KEYCLOAK_USER_USERNAME=REPLACE_ME
KEYCLOAK_USER_EMAIL=REPLACE_ME
KEYCLOAK_USER_PASSWORD=REPLACE_ME
KEYCLOAK_USER_FIRST_NAME=REPLACE_ME
KEYCLOAK_USER_LAST_NAME=REPLACE_ME

# Must match the port in WEBUI_URL, which is the address token audiences are checked against.
OPEN_WEBUI_PORT=3000

# Container name, image name, and tag for the application. These replace the upstream defaults so
# a local build does not retag an image used by another stack on the same Docker daemon.
WEBUI_CONTAINER_NAME=weather-skills-chat
WEBUI_IMAGE=weather-skills-chat
WEBUI_DOCKER_TAG=local

# Image name and tag for keycloak. docker-compose.keycloak.yaml uses the :- form for these, so an
# empty value falls back to the default. WEBUI_DOCKER_TAG uses the - form, so an empty value is
# passed through as empty.
KEYCLOAK_IMAGE=weather-skills-chat-keycloak
KEYCLOAK_DOCKER_TAG=local

# Redis address. The one-time artifact link claims its nonce here, and the web interface stores its
# persistent configuration here.
#
# Leave it commented out. docker-compose.redis.yaml (./run-compose.sh --redis) sets it to the redis
# service it adds; without that overlay it is empty. Uncomment it only to point at a Redis you run
# elsewhere. If the URL names a host that does not exist, every configuration read fails.
#
# Setting it to an empty value disables the one-time link even with the overlay loaded, because
# the overlay uses ${REDIS_URL-...}, which passes an empty value through.
#REDIS_URL=redis://redis:6379/0

# SKILL_SANDLOCK enables Landlock confinement for skill subprocesses. docker-compose.yaml defaults
# it to false. Set it to true where the kernel supports Landlock.
#SKILL_SANDLOCK=true
