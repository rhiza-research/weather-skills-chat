# Version control and CI
.git
.github

# Frontend dependencies and build output (rebuilt in image)
node_modules
build
.svelte-kit

# Python artifacts
__pycache__
*.py[cod]
*.pyo
*.pyd
.Python
.venv
venv
.env
.env.*
*.db
.ipynb_checkpoints

# Local/dev tooling
.cursor
.vscode
.idea
*.swp
